# FinanceGPT - Environment Variables

# ============================================
# API Configuration
# ============================================
API_V1_STR=/api/v1
ENVIRONMENT=local  # local | staging | production
PROJECT_NAME=FinanceGPT

# CORS (comma-separated origins)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================
# Supabase Configuration
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # Solo para operaciones admin

# ============================================
# Groq Configuration (Primary LLM - Free Tier)
# ============================================
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your-groq-api-key
GROQ_MODEL_SIMPLE=llama-3.1-8b-instant      # Fast, 14.4K req/day
GROQ_MODEL_COMPLEX=llama-3.3-70b-versatile  # Powerful, 1K req/day

# ============================================
# Cohere Configuration (Embeddings)
# ============================================
# Get your API key at: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your-cohere-api-key
COHERE_EMBED_MODEL=embed-multilingual-v3.0
COHERE_LLM_MODEL=command-r-plus  # Fallback LLM if Groq limits exceeded
EMBEDDING_DIMENSION=1024

# ============================================
# Gemini Configuration (Google AI - Pro quality)
# ============================================
# Get your API key at: https://aistudio.google.com/apikey
# Or use Vertex AI with Google Cloud $300 credit
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL_SIMPLE=gemini-1.5-flash    # Fast, ~$0.075/1M input
GEMINI_MODEL_COMPLEX=gemini-1.5-pro     # Best quality, ~$1.25/1M input

# ============================================
# Pinecone Configuration
# ============================================
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX=financegpt-transactions
PINECONE_ENVIRONMENT=us-east-1  # Región del índice

# ============================================
# Langfuse Configuration (Observability)
# ============================================
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com  # O tu instancia self-hosted

# ============================================
# Optional: Sentry (Error Tracking)
# ============================================
# SENTRY_DSN=https://your-sentry-dsn

# ============================================
# Optional: Redis (Caching)
# ============================================
# REDIS_URL=redis://localhost:6379/0
