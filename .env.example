# FinanceGPT - Environment Variables

# ============================================
# API Configuration
# ============================================
API_V1_STR=/api/v1
ENVIRONMENT=local  # local | staging | production
PROJECT_NAME=FinanceGPT

# CORS (comma-separated origins)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================
# Rate Limiting (chat cost / abuse control)
# ============================================
# Caps POST /chat per user (needs migration 012_rate_limits.sql). Reads are unaffected.
# In prod, override on Cloud Run via --set-env-vars.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_PER_MINUTE=10   # Burst guard: every turn (text or image)
RATE_LIMIT_CHAT_PER_DAY=100     # Daily text turns
RATE_LIMIT_IMAGES_PER_DAY=10    # Daily image turns (heavier: Gemini vision)

# ============================================
# Recurring transactions (daily materialization job)
# ============================================
# Shared secret guarding POST /recurring/run. A Cloud Scheduler job must send it
# in the X-Recurring-Secret header. Leave empty to keep the endpoint disabled
# (it fails closed). Needs migration 013_recurring_transactions.sql.
RECURRING_RUN_SECRET=

# ============================================
# Supabase Configuration
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=sb_secret_your-secret-key           # Backend (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-secret-key  # Admin operations
SUPABASE_ANON_KEY=sb_publishable_your-anon-key   # User auth (signup/login/JWT)

# ============================================
# LLM Provider
# ============================================
# groq -> Groq (Llama, free) | gemini -> Google AI Studio (API key)
# vertex -> Vertex AI Gemini (GCP credits, ADC auth) [recommended for this stack]
LLM_PROVIDER=groq
# Fallback chain on LLM error/overload: same-provider rescue + cross-provider Groq
LLM_FALLBACK_ENABLED=true

# ============================================
# Groq Configuration (LLM - Free Tier)
# ============================================
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your-groq-api-key
GROQ_MODEL_SIMPLE=llama-3.1-8b-instant      # Fast, 14.4K req/day
GROQ_MODEL_COMPLEX=llama-3.3-70b-versatile  # Powerful, 1K req/day

# ============================================
# Embedding Provider
# ============================================
# cohere -> Cohere Embed v3 (1024 dims) | vertex -> Vertex Gemini (768 dims)
# When using vertex, set EMBEDDING_DIMENSION=768 and configure GCP below.
EMBEDDING_PROVIDER=cohere
EMBEDDING_DIMENSION=1024

# ============================================
# Cohere Configuration (Embeddings)
# ============================================
# Get your API key at: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your-cohere-api-key
COHERE_EMBED_MODEL=embed-multilingual-v3.0
COHERE_LLM_MODEL=command-r-plus  # Fallback LLM if Groq limits exceeded

# ============================================
# Gemini Configuration (Google AI - Pro quality)
# ============================================
# Get your API key at: https://aistudio.google.com/apikey
# Or use Vertex AI with Google Cloud $300 credit
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL_SIMPLE=gemini-1.5-flash    # Fast, ~$0.075/1M input
GEMINI_MODEL_COMPLEX=gemini-1.5-pro     # Best quality, ~$1.25/1M input

# ============================================
# Google Cloud / Vertex AI (embeddings provider = vertex)
# ============================================
# Auth via ADC: run `gcloud auth application-default login` or set
# GOOGLE_APPLICATION_CREDENTIALS to a service-account JSON path.
GCP_PROJECT=your-gcp-project-id
GCP_LOCATION=us-central1
VERTEX_EMBED_MODEL=gemini-embedding-001  # Multilingual, output_dimensionality=768
VERTEX_LLM_MODEL_SIMPLE=gemini-2.0-flash   # Fast (classification/categorization)
VERTEX_LLM_MODEL_COMPLEX=gemini-2.5-flash  # Capable (analysis, planning, tools)

# ============================================
# Vector Store
# ============================================
# pinecone -> Pinecone Serverless | pgvector -> Postgres+pgvector (Supabase)
# For pgvector: run database/migrations/003_pgvector.sql, then re-seed categories.
VECTOR_STORE_PROVIDER=pinecone

# ============================================
# Pinecone Configuration (vector store = pinecone)
# ============================================
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX=financegpt-transactions
PINECONE_ENVIRONMENT=us-east-1  # Región del índice

# ============================================
# Langfuse Configuration (Observability)
# ============================================
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com  # O tu instancia self-hosted

# ============================================
# Optional: Sentry (Error Tracking)
# ============================================
# SENTRY_DSN=https://your-sentry-dsn

# ============================================
# Optional: Redis (Caching)
# ============================================
# REDIS_URL=redis://localhost:6379/0
